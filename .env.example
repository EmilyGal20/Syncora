ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://syncora:syncora_dev@localhost:5432/syncora
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:8600,http://127.0.0.1:8600
# Development only: optional regex for direct browser-to-API origins. Same-origin Vite proxy needs no CORS entry.
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2}|[a-zA-Z0-9-]+(?:\.local)?):8600$
AUDIT_SERVICE_URL=http://localhost:8501
AUDIT_SERVICE_KEY=replace-for-local-development
# Optional. The audit service uses a local SQLite file when unset; production/Docker use PostgreSQL.
# AUDIT_DATABASE_URL=Host=localhost;Port=5432;Database=syncora;Username=syncora;Password=syncora_dev
DEV_ADMIN_EMAIL=admin@syncora.dev
DEV_ADMIN_PASSWORD=ChangeMe123!
# Leave blank for same-origin /api requests. Vite proxies these to VITE_DEV_API_TARGET.
VITE_API_URL=
VITE_DEV_API_TARGET=http://127.0.0.1:8500
# Defaults to false in development and true in production. Production must use HTTPS.
# COOKIE_SECURE=true
